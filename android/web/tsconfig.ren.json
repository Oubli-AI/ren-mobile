{
  /* ren desktop's search page (src/ren, unmodified) and ElevenLabs UI's components (src/elevenlabs, unmodified, written
     for shadcn's strict defaults), checked with ren desktop's own compiler options. The app's own
     code is checked harder in tsconfig.app.json and sees these through their types. */
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/ren",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.ren.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    /* ren desktop names ES2022, and its program also loads ESNext through type-fest's types (src/components/ai-elements
       uses ES2023's toReversed); the phone's program doesn't load type-fest, so ESNext is named here. */
    "lib": ["ES2022", "ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/components/ui/orb": ["./src/elevenlabs/components/ui/orb"],
      "@/components/ui/audio-player": ["./src/elevenlabs/components/ui/audio-player"],
      "@/components/ui/waveform": ["./src/elevenlabs/components/ui/waveform"],
      "@/components/ui/voice-picker": ["./src/elevenlabs/components/ui/voice-picker"],
      "@/*": ["./src/ren/*"],
      "@catalyst/*": ["./src/ren/components/catalyst/*"]
    }
  },
  "include": ["src/ren", "src/elevenlabs", "src/data/*.json"]
}
