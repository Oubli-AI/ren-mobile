<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: the white logotype on its volt tile, on the ink stage. -->
    <style name="Theme.Ren" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ren_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/ren_stage</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ren_accent_tile</item>
    </style>
    <!-- Glass on Android 12+: what shows through is blurred, as ren desktop's sits on a frosted native material. The
         blur is off while the phone saves battery (WindowManager.isCrossWindowBlurEnabled), and the app then keeps
         the opaque palette, as ren's Reduce Transparency rule does. -->
    <style name="Theme.Ren.Glass">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackgroundBlurRadius">48dp</item>
    </style>
    <color name="ren_accent_tile">#FF5543FF</color>
</resources>
