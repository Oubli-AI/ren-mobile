<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen search bar: a flat card behind one hairline, fully round, so it sits on any wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="30dp" />
    <solid android:color="@color/ren_card" />
    <stroke android:width="1dp" android:color="@color/ren_edge" />
</shape>
