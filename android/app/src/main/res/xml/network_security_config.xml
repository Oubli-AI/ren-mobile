<?xml version="1.0" encoding="utf-8"?>
<!-- Pages in a browser can load http:// when HTTPS-Only is off; TLS trusts system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
