# The hosts come from REN_HOST and REN_HOOKS_HOST (compose passes them from deploy/vm/.env), defaulting to the
# owner's domains; any names whose DNS points at this server work, such as <ip-with-dashes>.sslip.io.
{$REN_HOST:rivet.ron-ai.dev} {
	@computer path /computer/*
	handle @computer {
		@token header Authorization "Bearer {$EMRYS_COMPUTER_TOKEN}"
		handle @token {
			reverse_proxy computer:8080
		}
		respond 401
	}
	# The Strands agents and Vibe's studio. Vibe is one of the app's bundled pages, so its requests take the token as
	# ren's pages do (X-Ren-Token, the cookie for its music WebSocket and audio), and its preflight goes straight through.
	@gemini path /gemini/*
	handle @gemini {
		@token header Authorization "Bearer {$EMRYS_GEMINI_TOKEN}"
		@page header X-Ren-Token {$EMRYS_GEMINI_TOKEN}
		@cookie header Cookie *ren_token={$EMRYS_GEMINI_TOKEN}*
		@preflight method OPTIONS
		handle @token {
			reverse_proxy gemini:8100
		}
		handle @page {
			reverse_proxy gemini:8100
		}
		handle @cookie {
			reverse_proxy gemini:8100
		}
		handle @preflight {
			reverse_proxy gemini:8100
		}
		respond 401
	}
	# Ren's hub: the phone and ren desktop attach to it (WebSocket) and call each other through it (MCP over HTTP).
	@hub path /hub/*
	handle @hub {
		uri strip_prefix /hub
		@token header Authorization "Bearer {$EMRYS_GEMINI_TOKEN}"
		handle @token {
			reverse_proxy hub:8300 {
				flush_interval -1
			}
		}
		respond 401
	}
	# ren desktop's backend for ren's pages in the app (search, Discover, Projects, Build, chat and the rest), on the
	# paths ren's pages call. ren's own code sends Authorization (a ren account's Supabase session), so the app's token
	# comes in X-Ren-Token. The bundled pages call from another origin, so the browser's preflight, which carries no
	# token, goes straight to the backend, which answers it for that origin only. /a2a stays loopback-only, as ren
	# desktop keeps it.
	handle /a2a* {
		respond 404
	}
	handle {
		@preflight method OPTIONS
		handle @preflight {
			reverse_proxy ren:8765
		}
		@token header X-Ren-Token {$EMRYS_GEMINI_TOKEN}
		# Deep research is loopback-only in ren desktop; with the token it goes through the container's own loopback.
		@research {
			header X-Ren-Token {$EMRYS_GEMINI_TOKEN}
			path /deep-research /deep-research/*
		}
		handle @research {
			reverse_proxy ren:8766 {
				flush_interval -1
				# uvicorn trusts forwarding headers from 127.0.0.1, so the phone's address must not come along.
				header_up -X-Forwarded-For
			}
		}
		handle @token {
			reverse_proxy ren:8765 {
				flush_interval -1
			}
		}
		# A WebSocket (voice, Teach Ren, Live Music) or an iframe (Build's live preview) can't carry a header, so the
		# app also gives its pages' WebViews the token as the cookie ren_token on this host.
		@cookie header Cookie *ren_token={$EMRYS_GEMINI_TOKEN}*
		handle @cookie {
			reverse_proxy ren:8765 {
				flush_interval -1
			}
		}
		respond 401
	}
}

desktop.{$REN_HOST:rivet.ron-ai.dev} {
	reverse_proxy laptop:3000
}

code.{$REN_HOST:rivet.ron-ai.dev} {
	reverse_proxy code:3000
}

{$REN_HOOKS_HOST:hooks.oubliai.com} {
	reverse_proxy hooks:8090
}
